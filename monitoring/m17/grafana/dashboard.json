{
  "uid": "harborops-m17",
  "title": "HarborOps | Local Service Diagnostics",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "editable": false,
  "refresh": "15s",
  "tags": [
    "harborops",
    "local",
    "m17"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "harborops-local-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(harborops_request_duration_seconds_count[5m]))",
          "refId": "A",
          "legendFormat": "API request rate",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "API 5xx rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "harborops-local-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(harborops_request_failures_total[5m]))",
          "refId": "A",
          "legendFormat": "API 5xx rate",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "API p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "harborops-local-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(harborops_request_duration_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "API p95 latency",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "PostgreSQL readiness (-1 unknown, 0 down, 1 up)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "harborops-local-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "harborops_db_readiness",
          "refId": "A",
          "legendFormat": "PostgreSQL readiness (-1 unknown, 0 down, 1 up)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "Notification worker (0 disabled, 1 active)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "harborops-local-metrics"
      },
      "gridPos": {
        "x": 18,
        "y": 8,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "harborops_service_running{service=\"notifications\"}",
          "refId": "A",
          "legendFormat": "Notification worker (0 disabled, 1 active)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "title": "Telemetry heartbeat sample age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "harborops-local-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "time() - timestamp(harborops_telemetry_heartbeat_total)",
          "refId": "A",
          "legendFormat": "Telemetry heartbeat sample age",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Bounded sampling drops",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "harborops-local-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(increase(harborops_telemetry_dropped_total[5m]))",
          "refId": "A",
          "legendFormat": "Bounded sampling drops",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Active local alerts",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "harborops-local-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "ALERTS{alertstate=\"firing\"}",
          "refId": "A",
          "legendFormat": "Active local alerts",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
