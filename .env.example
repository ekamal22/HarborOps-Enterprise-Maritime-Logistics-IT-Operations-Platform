# Copy to .env and replace with a unique local password.
# Never use this example value in a shared or hosted environment.
HARBOROPS_DB_PASSWORD=replace-with-a-unique-local-password
# Set separate passwords for runtime identities, distinct from each other and
# from HARBOROPS_DB_PASSWORD. The migrator provisions these roles on startup.
HARBOROPS_API_DB_PASSWORD=replace-with-a-distinct-api-password
HARBOROPS_WORKER_DB_PASSWORD=replace-with-a-distinct-worker-password
