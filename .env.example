# Copy to .env and replace with a unique local password.
# Never use this example value in a shared or hosted environment.
HARBOROPS_DB_PASSWORD=replace-with-a-unique-local-password
# Set separate passwords for runtime identities, distinct from each other and
# from HARBOROPS_DB_PASSWORD. The migrator provisions these roles on startup.
HARBOROPS_API_DB_PASSWORD=replace-with-a-distinct-api-password
HARBOROPS_WORKER_DB_PASSWORD=replace-with-a-distinct-worker-password
# Correction signing key for the M10 shipment-tracking correction route. It must be a
# private base64 encoding of exactly 32 cryptographically random bytes. The migrator
# stores a verifier copy and the API signs with it; the worker and web never receive it.
# Generate one locally and keep it out of version control, for example:
#   node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64'))"
HARBOROPS_M10_CORRECTION_PROOF_KEY=replace-with-a-generated-base64-32-byte-key

# M12 shipment-export audit proof, independent from the M10 correction key.
# Supply a different private base64 encoding of 32 random bytes to migrator/API.
# An unset key fails CSV export closed (503); malformed configured keys fail provisioning.
# Generate it locally as for the M10 key above and keep it out of version control.
HARBOROPS_M12_EXPORT_PROOF_KEY=replace-with-a-distinct-generated-base64-32-byte-key

# M15 scoped in-app notification delivery is disabled unless explicitly enabled.
# Keep false during initial rollout, verification and pending G15 acceptance.
# Enabling delivery does not enable M9 transport, M10 projection or M11 evaluation.
HARBOROPS_M15_ENABLE_DELIVERY=false
