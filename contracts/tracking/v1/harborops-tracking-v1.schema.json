{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harborops.invalid/contracts/tracking/v1/harborops-tracking-v1.schema.json",
  "title": "HarborOps tracking input, provisional M7 subset",
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceEventId", "family", "code", "classifier", "occurredAtUtc", "externalSchemaVersion"],
  "properties": {
    "sourceEventId": {"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9._:-]+$"},
    "family": {"enum":["Equipment","Transport"]},
    "code": {"enum":["GTIN","GTOT","ARRI","DEPA"]},
    "classifier": {"const":"ACT"},
    "occurredAtUtc": {"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?(Z|\\+00:00)$"},
    "equipmentReference": {"type":"string"},
    "transportReference": {"type":"string"},
    "externalSchemaVersion": {"const":"2.2.0"}
  },
  "oneOf": [
    {"properties":{"family":{"const":"Equipment"},"code":{"enum":["GTIN","GTOT"]}},
     "required":["equipmentReference"],"not":{"required":["transportReference"]}},
    {"properties":{"family":{"const":"Transport"},"code":{"enum":["ARRI","DEPA"]}},
     "required":["transportReference"],"not":{"required":["equipmentReference"]}}
  ]
}
